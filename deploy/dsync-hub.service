[Unit]
Description=dsync hub — machine state synchronizer over QUIC
Documentation=https://github.com/mflkee/dsync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/dsync-hub hub
Restart=on-failure
RestartSec=5
User=%i
Group=%i

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/mflkee/.local/share/dsync

[Install]
WantedBy=default.target
